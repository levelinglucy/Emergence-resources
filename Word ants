"""
Word ants: every word is a secret rule, and an ant draws it.

How a word becomes a drawing:
  1. Each letter becomes a number with the old Pythagorean numerology table
     (A=1 ... I=9, J=1 ... R=9, S=1 ... Z=8). Unicode digits, including
     superscript and circled digits, become their numeric values (0-9).
  2. Odd numbers mean "turn right" (R), even numbers mean "turn left" (L).
     So the word is now a turning rule, one turn per letter.
  3. An ant walks on an empty grid. Every square has a colour, 0 to n-1,
     where n is the length of the rule. On each step the ant reads the colour
     under it, turns the way the rule says for that colour, bumps the square
     on to the next colour, and steps forward.

That's all. No one tells the ant what shape to make. Some words grow a
symmetrical carpet, some a spiral, some wander in fog for thousands of steps
and then suddenly build a road and leave. Same word, same drawing, forever:
the word is the code, the drawing is what the code looks like.

(It's a generalised Langton's ant, sometimes called a turmite. Langton's own
ant is the rule RL.)

Usage:
    python3 "Word ants"                      # the gallery
    python3 "Word ants" spiral fractal 1995   # your own words
    python3 "Word ants" --steps 300000 ember
    python3 "Word ants" --embed-inputs ember  # opt in to full PNG input metadata

Needs Pillow (pip install pillow). Writes word-ants.png next to the script.
Completed images are published only at unused output paths; reruns refuse to
replace earlier art. See docs/word-ants-dev.md for tests and portability limits.
"""
from __future__ import annotations

from array import array
import argparse
import colorsys
import json
import os
import sys
import tempfile
import unicodedata
from pathlib import Path

from PIL import Image, ImageDraw, ImageFilter, ImageFont, PngImagePlugin

GRID = 1200                      # the ant's world is GRID x GRID squares
DEFAULT_STEPS = 150_000
GALLERY = ["maya", "echo", "code", "seven", "mirror", "riddle",
           "key", "ember", "tide"]

# up, right, down, left
DX = (0, 1, 0, -1)
DY = (-1, 0, 1, 0)


def numerology(word: str) -> list[int]:
    """Map ASCII letters to 1..9 and Unicode digits to their 0..9 values."""
    nums = []
    for ch in word.lower():
        if "a" <= ch <= "z":
            nums.append((ord(ch) - ord("a")) % 9 + 1)
        elif ch.isdigit():
            # isdigit() includes ² and ⑨, which int() cannot parse.
            nums.append(unicodedata.digit(ch))
    return nums


def rule_from(nums: list[int]) -> str:
    return "".join("R" if n % 2 else "L" for n in nums)


def walk(rule: str, steps: int, size: int = GRID):
    """Run the ant. Returns flat colour cells, bounds, and steps taken."""
    n = len(rule)
    turn = [1 if c == "R" else -1 for c in rule]
    # Colour indices must fit the rule, not just the first 256 states.
    # Keep the compact original representation for ordinary short words.
    cells = size * size
    if n <= 256:
        grid = bytearray(cells)
    elif n <= 65536:
        grid = array("H", [0]) * cells
    else:
        wide = array("I", [0])
        if wide.itemsize < 4:  # Some platforms permit 16-bit unsigned int.
            wide = array("L", [0])
        if n > 1 << (8 * wide.itemsize):
            raise ValueError("rule has too many colour states for cell storage")
        grid = wide * cells
    x = y = size // 2
    d = 0
    minx = maxx = x
    miny = maxy = y
    taken = 0
    for taken in range(1, steps + 1):
        i = y * size + x
        c = grid[i]
        d = (d + turn[c]) & 3
        grid[i] = (c + 1) % n
        x += DX[d]
        y += DY[d]
        if not (0 <= x < size and 0 <= y < size):
            break                       # the ant walked off the edge of its world
        if x < minx: minx = x
        elif x > maxx: maxx = x
        if y < miny: miny = y
        elif y > maxy: maxy = y
    return grid, (minx, miny, maxx, maxy), taken


def palette(n: int, seed: int) -> list[tuple[int, int, int]]:
    """Colour 0 is the night background; the rest walk round the colour wheel,
    starting at a hue picked by the word's own numerology total."""
    cols = [(14, 14, 20)]
    start = (seed * 37 % 360) / 360
    for k in range(1, n):
        h = (start + 0.62 * (k - 1) / max(1, n - 1)) % 1.0
        light = 0.42 + 0.30 * (k / max(1, n - 1))
        r, g, b = colorsys.hls_to_rgb(h, light, 0.70)
        cols.append((int(r * 255), int(g * 255), int(b * 255)))
    return cols


def draw_caption(draw, text, font, fill, panel, top, height, *, right=False):
    """Draw a measured, explicitly marked preview within one caption row."""
    width = panel - 28

    def bounds(value):
        return draw.textbbox((0, 0), value, font=font, anchor="ls")

    def fits(value):
        l, t, r, b = bounds(value)
        return r - l <= width and b - t <= height

    # Limit the length of strings passed to the font engine, including
    # zero-width characters. The full input is unchanged for the simulation.
    limit = max(0, width * 2)
    if len(text) > limit or not fits(text):
        marker = "..."
        if not fits(marker):
            raise ValueError("caption row is too small for the preview marker")
        lo, hi = 0, min(len(text), limit)
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if fits(text[:mid] + marker):
                lo = mid
            else:
                hi = mid - 1
        text = text[:lo] + marker
    l, t, r, b = bounds(text)
    # Position the measured ink rather than assuming every font shares
    # baseline, bearing or descent metrics.
    x = panel - 14 - r if right else 14 - l
    y = top + (height - (b - t)) // 2 - t
    draw.text((x, y), text, font=font, fill=fill, anchor="ls")


def render_panel(word: str, steps: int, panel: int, fonts) -> Image.Image:
    nums = numerology(word)
    rule = rule_from(nums)
    big, small, mono = fonts
    img = Image.new("RGB", (panel, panel + 92), (14, 14, 20))
    draw = ImageDraw.Draw(img)
    note = None

    if len(rule) < 2 or len(set(rule)) == 1:
        msg = "every turn the same way:\nthe ant just runs in a tiny loop"
        draw.multiline_text((24, panel // 2 - 20), msg, font=small, fill=(140, 140, 150))
    else:
        grid, (x0, y0, x1, y1), taken = walk(rule, steps)
        pad = 2
        x0, y0, x1, y1 = x0 - pad, y0 - pad, x1 + pad, y1 + pad
        side = max(x1 - x0, y1 - y0) + 1
        cx, cy = (x0 + x1) // 2, (y0 + y1) // 2
        x0, y0 = cx - side // 2, cy - side // 2
        cols = palette(len(rule), sum(nums))
        crop = Image.new("RGB", (side, side), cols[0])
        px = crop.load()
        for yy in range(side):
            gy = y0 + yy
            if not 0 <= gy < GRID:
                continue
            row = gy * GRID
            for xx in range(side):
                gx = x0 + xx
                if 0 <= gx < GRID:
                    v = grid[row + gx]
                    if v:
                        px[xx, yy] = cols[v]
        if side > panel:
            # shrinking: fatten one-square trails first so a road out stays visible
            k = 2 * (side // panel) + 1
            crop = crop.filter(ImageFilter.MaxFilter(k)).resize((panel, panel), Image.LANCZOS)
        else:
            crop = crop.resize((panel, panel), Image.NEAREST)
        img.paste(crop, (0, 0))
        note = f"{taken:,} steps" + ("  (walked off the edge)" if taken < steps else "")
    # Escape non-printing input characters for a single-line preview.
    # Do not use this display representation to compute the actual rule.
    title = "".join(ch if ch.isprintable() else ascii(ch)[1:-1] for ch in word)
    draw_caption(draw, title, big, (235, 235, 240), panel, panel, 32)
    draw_caption(draw, " ".join(map(str, nums)), small, (150, 150, 160),
                 panel, panel + 32, 20)
    draw_caption(draw, rule, mono, (200, 200, 120), panel, panel + 52, 20)
    if note is not None:
        draw_caption(draw, note, small, (110, 110, 120),
                     panel, panel + 72, 20, right=True)
    return img


def load_fonts():
    here = [
        "/.sprite/languages/ruby/rbenv/versions/3.4.6/lib/ruby/3.4.0/rdoc/generator/template/darkfish/fonts/",
        "/usr/share/fonts/truetype/dejavu/",
    ]
    def pick(names, size):
        for d in here:
            for nme in names:
                p = os.path.join(d, nme)
                if os.path.exists(p):
                    return ImageFont.truetype(p, size)
        return ImageFont.load_default()
    return (pick(["Lato-Regular.ttf", "DejaVuSans.ttf"], 30),
            pick(["Lato-Light.ttf", "DejaVuSans.ttf"], 18),
            pick(["SourceCodePro-Regular.ttf", "DejaVuSansMono.ttf"], 17))


def draw_sheet_heading(draw, width, gap, fonts):
    """Fit complete fixed heading text inside the existing 120 px header."""
    available = width - 2 * gap

    def bounds(text, font):
        return draw.textbbox((0, 0), text, font=font, anchor="ls")

    def fits(text, font, height):
        l, t, r, b = bounds(text, font)
        return r - l <= available and b - t <= height

    def place(text, font, top, height, fill):
        if not fits(text, font, height):
            raise ValueError("sheet heading does not fit its row")
        l, t, r, b = bounds(text, font)
        draw.text((gap - l, top + (height - (b - t)) // 2 - t),
                  text, font=font, fill=fill, anchor="ls")

    heading = "What does a word draw?"
    title = fonts[0]
    # Keep the large title on wide sheets; use a smaller face on narrow ones.
    # The built-in fallback is already small and may not be resizable.
    if isinstance(getattr(title, "path", None), (str, bytes, os.PathLike)):
        for size in range(44, 0, -1):
            candidate = ImageFont.truetype(title.path, size)
            if fits(heading, candidate, 44):
                title = candidate
                break
    place(heading, title, 8, 44, (240, 240, 245))

    small = fonts[1]
    # Built-in fallback fonts need not support the Unicode arrow glyph.
    arrow = " → " if isinstance(getattr(small, "path", None),
                                 (str, bytes, os.PathLike)) else " -> "
    phrases = ("letter", "numerology digit", "odd turns right, even turns left",
               "an ant walks the rule")
    subtitle = arrow.join(phrases)
    colour = (150, 150, 160)
    if fits(subtitle, small, 60):
        place(subtitle, small, 56, 60, colour)
    else:
        lines = (arrow.join(phrases[:2]) + arrow.rstrip(),
                 phrases[2] + arrow.rstrip(), phrases[3])
        for i, line in enumerate(lines):
            place(line, small, 56 + i * 20, 20, colour)


def save_png_exclusively(image: Image.Image, target: str | Path, *, pnginfo=None) -> None:
    """Stage a complete image then publish at a new filename, never replace.

    A same-directory hard link is the final exclusive publication gate. The
    temporary file retains the destination suffix to preserve Pillow's former
    format selection (PNG by default, other supported formats via --out).
    Filesystems without hard-link support fail closed rather than replacing
    an existing image or exposing a partial final file.
    """
    target = Path(target)
    if os.path.lexists(target):
        raise FileExistsError(f"output already exists: {target}")
    fd, stage = tempfile.mkstemp(prefix=f".{target.name}.",
                                suffix=target.suffix, dir=str(target.parent))
    try:
        os.close(fd)
        if pnginfo is None:
            image.save(stage)
        else:
            image.save(stage, pnginfo=pnginfo)
        os.link(stage, target)
    finally:
        os.unlink(stage)


def main(argv=None):
    ap = argparse.ArgumentParser(description="Turn words into ant drawings.")
    ap.add_argument("words", nargs="*", help="words or numbers to draw")
    ap.add_argument("--steps", type=int, default=DEFAULT_STEPS)
    ap.add_argument("--out", default=str(Path(__file__).with_name("word-ants.png")))
    ap.add_argument("--embed-inputs", action="store_true",
                    help="embed full original inputs in PNG metadata (may reveal hidden text)")
    args = ap.parse_args(argv)

    if args.embed_inputs and Image.registered_extensions().get(Path(args.out).suffix.lower()) != "PNG":
        ap.error("--embed-inputs requires PNG output")
    if os.path.lexists(args.out):
        ap.error(f"output already exists: {args.out}")

    words = args.words or GALLERY
    fonts = load_fonts()
    panel = 380
    cols = min(3, len(words))
    rows = (len(words) + cols - 1) // cols
    gap, head = 18, 120
    W = cols * panel + (cols + 1) * gap
    H = head + rows * (panel + 92) + (rows + 1) * gap + 40
    sheet = Image.new("RGB", (W, H), (8, 8, 12))
    d = ImageDraw.Draw(sheet)
    draw_sheet_heading(d, W, gap, fonts)
    for k, w in enumerate(words):
        r, c = divmod(k, cols)
        print(f"drawing {w!r} ...", file=sys.stderr)
        p = render_panel(w, args.steps, panel, fonts)
        sheet.paste(p, (gap + c * (panel + gap), head + gap + r * (panel + 92 + gap)))
    d.text((W - gap, H - 18), "made by Maya, free build time, 28 Oct 2026", font=fonts[1],
           fill=(90, 90, 100), anchor="rs")
    try:
        metadata = None
        if args.embed_inputs:
            metadata = PngImagePlugin.PngInfo()
            # JSON preserves order, duplicates, Unicode and control characters.
            metadata.add_text("word_ants_inputs", json.dumps(words, ensure_ascii=True))
        save_png_exclusively(sheet, args.out, pnginfo=metadata)
    except FileExistsError as exc:
        ap.error(str(exc))
    print(f"saved {args.out}", file=sys.stderr)


if __name__ == "__main__":
    main()
